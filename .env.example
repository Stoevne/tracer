# =============================================================================
# Tracer — Environment Variables
# =============================================================================
# Kopiere diese Datei zu .env.local und fülle die Werte ein.
# Variablen mit NEXT_PUBLIC_ Prefix sind im Browser sichtbar — alle anderen
# nur server-side. Niemals service_role oder secret keys ins NEXT_PUBLIC_-Set.
#
# Reihenfolge nach Wochen geordnet — nur das holen, was die jeweilige Woche
# braucht.

# -----------------------------------------------------------------------------
# KW 1 — Foundation
# -----------------------------------------------------------------------------

# Deine Domain, mit Protokoll, ohne Trailing-Slash
NEXT_PUBLIC_SITE_URL=https://tracer.studio

# Supabase (https://supabase.com — Region: eu-central-1 / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# KW 2 — Bildgenerierung
# -----------------------------------------------------------------------------

# Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=r8_...

# OpenAI für Prompt-Crafting (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# KW 4 — Stripe
# -----------------------------------------------------------------------------

# Stripe (https://dashboard.stripe.com/apikeys — Live + Test trennen!)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price-IDs der drei Tarife (in Stripe-Dashboard erstellen)
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRAXIS=price_...
STRIPE_PRICE_TEAM=price_...

# -----------------------------------------------------------------------------
# KW 5 — Source-Pipeline & Embeddings
# -----------------------------------------------------------------------------

# Voyage AI für Embeddings (https://www.voyageai.com)
VOYAGE_API_KEY=pa-...

# -----------------------------------------------------------------------------
# KW 6 — LLM-Curator & Newsletter-Versand
# -----------------------------------------------------------------------------

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Beehiiv (https://app.beehiiv.com → Settings → API)
BEEHIIV_API_KEY=...
BEEHIIV_PUBLICATION_ID=pub_...

# Owner-Mail für Newsletter-Approval-Mails
OWNER_EMAIL=you@example.com

# Geheimer Token für Magic-Link-Approve-URLs (langer Random-String)
APPROVAL_SECRET=

# -----------------------------------------------------------------------------
# KW 8 — Customer Support
# -----------------------------------------------------------------------------

# Crisp (https://app.crisp.chat → Settings → Workspace settings → Setup)
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# -----------------------------------------------------------------------------
# Cron-Security (immer)
# -----------------------------------------------------------------------------

# Geheimer Token für Cron-Endpunkte (verhindert Public-Trigger).
# Wird als Header `Authorization: Bearer $CRON_SECRET` von Vercel-Cron gesendet.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Monitoring (optional, ab KW 9)
# -----------------------------------------------------------------------------

# Sentry (https://sentry.io)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Discord-Webhook für Error-Alerts
DISCORD_ERROR_WEBHOOK=

# Plausible (selbst-gehostet oder cloud)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tracer.studio
