# =============================================================================
# Tracer — Environment Variables
# =============================================================================
# Kopiere diese Datei zu .env.local und fülle die Werte ein.
# Variablen mit NEXT_PUBLIC_ Prefix sind im Browser sichtbar — alle anderen
# nur server-side. Niemals service_role oder secret keys ins NEXT_PUBLIC_-Set.

# -----------------------------------------------------------------------------
# KW 1 — Foundation
# -----------------------------------------------------------------------------

# Deine Domain, mit Protokoll, ohne Trailing-Slash
NEXT_PUBLIC_SITE_URL=https://tracer.molmed.eu

# Supabase (https://supabase.com — Region: eu-central-1 / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# KW 2 — Bildgenerierung
# -----------------------------------------------------------------------------

# Replicate (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=r8_...

# OpenAI für Prompt-Crafting (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Cron-Security (KW 5+) — auch für /api/studio/generate und /studio/library?key=
# -----------------------------------------------------------------------------

# Geheimer Token für Cron-Endpunkte und Owner-Library-Zugriff.
# Mind. 32 chars random hex empfohlen.
CRON_SECRET=

# -----------------------------------------------------------------------------
# KW 4 — Stripe
# -----------------------------------------------------------------------------

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price-IDs der drei Subscription-Tarife (in Stripe-Dashboard erstellen)
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRAXIS=price_...
STRIPE_PRICE_TEAM=price_...

# -----------------------------------------------------------------------------
# KW 5 — Embeddings
# -----------------------------------------------------------------------------

# Voyage AI für News-Embeddings (https://www.voyageai.com)
VOYAGE_API_KEY=pa-...

# -----------------------------------------------------------------------------
# KW 6 — LLM-Curator + Mail + Newsletter
# -----------------------------------------------------------------------------

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Resend für transaktionale Mails (https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM=Tracer <noreply@tracer.molmed.eu>

# Beehiiv (https://app.beehiiv.com → Settings → API)
BEEHIIV_API_KEY=...
BEEHIIV_PUBLICATION_ID=pub_...

# Owner-Mail für Brief-Approval-Mails
OWNER_EMAIL=stephan.ellmann@gmail.com

# Geheimer Token für Magic-Approve-Links (langer Random-String, mind. 32 chars)
APPROVAL_SECRET=

# -----------------------------------------------------------------------------
# KW 8 — Customer Support
# -----------------------------------------------------------------------------

# Crisp (https://app.crisp.chat → Settings → Setup)
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# -----------------------------------------------------------------------------
# KW 9 — Sponsoren
# -----------------------------------------------------------------------------

# Optional: Stripe-Price für Standard-Sponsor-Slot. Wenn leer, nutzt
# der Code SPONSOR_SLOT_PRICE_CENTS als ad-hoc-Preis.
STRIPE_PRICE_SPONSOR_SLOT=

# Default Slot-Preis in Cent (80000 = 800 €)
SPONSOR_SLOT_PRICE_CENTS=80000

# -----------------------------------------------------------------------------
# KW 10 — Analytics
# -----------------------------------------------------------------------------

# Plausible — cookie-frei, kein Banner nötig
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tracer.molmed.eu

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------

# Sentry (https://sentry.io)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Discord-Webhook für Error-Alerts
DISCORD_ERROR_WEBHOOK=
